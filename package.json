{
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:css && next build",
    "start": "next start",
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./styles.css",
    "watch:css": "tailwindcss -i ./src/tailwind.css -o ./styles.css --watch",
    "cf:build": "npm run build:css && opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "next": "^16.2.12",
    "playwright": "^1.62.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "wrangler": "^4.118.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
